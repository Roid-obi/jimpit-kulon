rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Functions for authorization
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin' && getUserData().isActive == true;
    }
    
    function isPetugas() {
      return isAuthenticated() && (getUserData().role == 'petugas' || getUserData().role == 'admin') && getUserData().isActive == true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if (isAuthenticated() && request.auth.uid == userId) || isPetugas();
      allow create: if isAuthenticated() && ((request.auth.uid == userId && request.resource.data.role == 'petugas') || isAdmin());
      // Admin update: cannot demote own role or deactivate own account
      allow update: if isAdmin() && (
        request.auth.uid != userId || (
          request.resource.data.role == resource.data.role &&
          request.resource.data.isActive == resource.data.isActive
        )
      );
      // Admin delete: cannot delete own account
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // Houses Collection
    match /houses/{houseId} {
      allow read: if isPetugas();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Periods Collection
    match /periods/{periodId} {
      allow read: if isPetugas();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if isPetugas();
      allow create: if isPetugas();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Financial Transactions Collection
    match /financial_transactions/{transactionId} {
      allow read: if isPetugas();
      allow create: if isPetugas();
      allow update, delete: if false;
    }

    // Settings Collection
    match /settings/{document=**} {
      allow read: if isPetugas();
      allow write: if isAdmin();
    }
  }
}
